{
  "expo": {
    "name": "Factures",
    "slug": "invoice-organizer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "invoice-organizer",
    "userInterfaceStyle": "light",
    "locales": {
      "fr": "./locales/fr.json",
      "zh": "./locales/zh.json"
    },
    "ios": {
      "bundleIdentifier": "com.kikiwen.invoiceorganizer",
      "supportsTablet": false,
      "infoPlist": {
        "CFBundleDevelopmentRegion": "fr",
        "CFBundleAllowMixedLocalizations": true,
        "NSCameraUsageDescription": "Pour scanner et organiser vos factures",
        "NSPhotoLibraryUsageDescription": "Pour sélectionner des photos de factures depuis votre galerie",
        "ITSAppUsesNonExemptEncryption": false,
        "UIFileSharingEnabled": true,
        "LSSupportsOpeningDocumentsInPlace": true
      }
    },
    "android": {
      "package": "com.kikiwen.invoiceorganizer",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#E6F4FE"
      },
      "permissions": [
        "CAMERA",
        "READ_MEDIA_IMAGES"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-sharing",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Pour sélectionner des photos de factures depuis votre galerie",
          "microphonePermission": false
        }
      ],
      [
        "react-native-document-scanner-plugin",
        {
          "cameraPermission": "Pour scanner et organiser vos factures"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1bd521ea-94f9-457e-98b7-8cb87ad2848b"
      }
    },
    "owner": "kikiwen"
  }
}
