{
  "expo": {
    "name": "snapPDF",
    "slug": "snappdf",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "invoice-organizer",
    "userInterfaceStyle": "light",
    "locales": {
      "fr": "./locales/fr.json",
      "en": "./locales/en.json",
      "zh": "./locales/zh.json"
    },
    "ios": {
      "bundleIdentifier": "com.kikiwen.invoiceorganizer",
      "supportsTablet": false,
      "infoPlist": {
        "CFBundleDevelopmentRegion": "fr",
        "CFBundleAllowMixedLocalizations": true,
        "NSCameraUsageDescription": "Pour scanner et organiser vos factures",
        "NSPhotoLibraryUsageDescription": "Pour sélectionner des photos de factures depuis votre galerie",
        "ITSAppUsesNonExemptEncryption": false,
        "UIFileSharingEnabled": false,
        "LSSupportsOpeningDocumentsInPlace": false
      }
    },
    "android": {
      "package": "com.kikiwen.invoiceorganizer",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-sharing",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Pour sélectionner des photos de factures depuis votre galerie",
          "microphonePermission": false
        }
      ],
      [
        "react-native-document-scanner-plugin",
        {
          "cameraPermission": "Pour scanner et organiser vos factures"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/splash.png",
          "imageWidth": 280,
          "resizeMode": "contain"
        }
      ],
      "expo-iap"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "032eaa54-44e0-4cb6-83aa-02155d05e7c7"
      }
    },
    "owner": "qiwen321s-team",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/032eaa54-44e0-4cb6-83aa-02155d05e7c7"
    }
  }
}
